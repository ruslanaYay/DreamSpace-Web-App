{
  "email": "new.user123@gmail.com",
  "password": "твоя_пароль_тут"
}

###
# 🔴 ВАЖЛИВО: Скопіюй отриманий після логіну токен і встав його сюди замість тексту:
@token = eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJtYXJpaWEuYmVyZG55azFAbnVyZS51YSIsInJvbGUiOiJVU0VSIiwiaWF0IjoxNzgwNzg5NzEzLCJleHAiOjE3ODA4NzYxMTN9.k234UZvB53wIVCQAFqezH5PHizO_5I9HYEf7Aqcl56w


### ==========================================
### Сценарій 1: Успішне скасування бронювання (Очікуємо 204)
### ==========================================
# 🔍 Знайди в базі ID індивідуального бронювання, яке належить твоєму юзеру (наприклад, id = 1)
DELETE http://localhost:8085/api/reservations/1
Authorization: Bearer {{token}}


### ==========================================
### Сценарій 2: Помилка авторизації (Очікуємо 401 або 403)
### ==========================================
# Робимо запит БЕЗ заголовка Authorization (без токена)
DELETE http://localhost:8085/api/reservations/1

# 🎯 Очікувана відповідь сервера: Status 401 або 403
# Body: { "message": "Увійдіть в обліковий запис" }


### ==========================================
### Сценарій 3: Спроба скасувати чуже бронювання (Очікуємо 403)
### ==========================================
# 🔍 Підстав ID бронювання, яке в базі належить ІНШОМУ користувачу (наприклад, id = 2)
DELETE http://localhost:8085/api/reservations/1
Authorization: Bearer {{token}}

# 🎯 Очікувана відповідь сервера: Status 403 Forbidden
# Body: { "message": "Доступ заборонено" }


### ==========================================
### Сценарій 4: Бронювання не знайдено (Очікуємо 404)
### ==========================================
# Передаємо ID, якого точно немає в базі даних (наприклад, 999999)
DELETE http://localhost:8085/api/reservations/999999
Authorization: Bearer {{token}}

# 🎯 Очікувана відповідь сервера: Status 404 Not Found
# Body: { "message": "Бронювання не знайдено" }

### ==========================================
### Отримання списку моїх заброньованих бажань (Очікуємо 200 OK з JSON пагінацією)
### ==========================================
# Запит з дефолтними параметрами (page=0, size=4)
GET http://localhost:8085/api/reservations/my
Authorization: Bearer {{token}}

###
# Запит з іншим розміром сторінки
GET http://localhost:8085/api/reservations/my?page=0&size=2
Authorization: Bearer {{token}}


